      <aliases enabled='yes' />
      <column aggregation='Sum' datatype='integer' default-format='*000' name='[Area Code]' role='dimension' semantic-role='[AreaCode].[Name]' type='ordinal' />
      <column caption='Profit Margin %' datatype='real' default-format='p0.00%' name='[Calculation_608267479639998464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - SUM([Cost of Goods Sold (COGS)]) - SUM([Total Expenses])) / SUM([Sales])' />
      </column>
      <column caption='Budget Profit Margin %' datatype='real' default-format='p0.00%' name='[Calculation_608267479640834049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Budget Sales]) - SUM([Budget COGS]) - SUM([Budget Profit])) / SUM([Budget Sales])' />
      </column>
      <column caption='State' datatype='string' name='[Calculation_608267479689351170]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='SPLIT([State &amp; Region], &apos;;&apos;, 1)' />
      </column>
      <column caption='Region' datatype='string' name='[Calculation_608267479689605123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([State &amp; Region], &apos;;&apos;, 2)' />
